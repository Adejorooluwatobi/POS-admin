{
  "name": "pos-admin",
  "version": "0.0.0",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "build:electron": "ng build && electron .",
    "cap:sync": "cap sync",
    "build:android": "ng build && cap sync",
    "package:desktop": "ng build && electron-packager . \"POS Portal\" --platform=win32 --arch=x64 --out=dist-desktop --overwrite"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "build": {
    "appId": "com.adejorooluwatobi.posportal",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/pos-admin/browser/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@ngxpert/hot-toast": "^6.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "chart.js": "^4.5.1",
    "postcss": "^8.5.10",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.3.4",
    "electron": "^42.2.0",
    "electron-packager": "^17.1.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
